PORT=4000
NODE_ENV=development

# DB_DIALECT=sqlite for local dev (no server needed), mysql for production
DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite

# Used only when DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lokmangal_foundation
DB_USER=root
DB_PASSWORD=

# Set to 1/true when the MySQL host requires TLS (Aiven, PlanetScale,
# Railway, and most managed providers do). Leave unset for a local/self-hosted
# MySQL with no certificate.
# DB_SSL=1

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Set to 1 ONLY when running behind a trusted reverse proxy (e.g. Nginx) that
# sets X-Forwarded-For/Proto itself. Leave unset otherwise — enabling this
# without a real proxy in front lets clients spoof their IP and bypass rate
# limiting.
# TRUST_PROXY=1

# Seed admin login (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@lokmangalfoundation.org
SEED_ADMIN_PASSWORD=change-this-password

# STORAGE_DRIVER=local (default) saves uploads to backend/uploads/ -- zero
# setup for local dev, but files don't survive a redeploy/multi-instance
# hosting. Set to s3 for production so uploads persist in an S3 bucket.
# STORAGE_DRIVER=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
